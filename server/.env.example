# 复制这个文件成 .env（同目录），再填上自己的 key。
# .env 已写进 .gitignore，不会被提交；也绝不要贴到聊天/截图里。
#
# 本机最省事的用法其实不用 .env，直接在 PowerShell 里设：
#   $env:TWIN_API_KEY="sk-..."
#   node twin-server.js
#
# 用 .env 时启动方式不变：node twin-server.js（服务端会自己读）

TWIN_API_KEY=sk-在这里填你在 platform.deepseek.com 创建的 key

# ——— 以下都是可选项，不写就走默认值 ———
# TWIN_BASE_URL=https://api.deepseek.com/v1
# TWIN_MODEL=deepseek-chat
# PORT=8787
# ALLOWED_ORIGIN=*
